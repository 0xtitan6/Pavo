# Copy to .env, fill in the values, and load it before running Hardhat:
#   set -a && source .env && set +a

# Sepolia signer and RPC endpoint
PRIVATE_KEY=
SEPOLIA_URL=
ETHERSCAN_API_KEY=

# Live hourly GPU-rate poster (Ornn OCPI)
# Obtain Ornn's written data/redistribution licence before publishing values to
# a public on-chain feed. The feed source can be changed for a licensed API.
ORNN_API_BASE_URL=https://api.ornnai.com
# Leave empty for an unauthenticated private demo. For a licensed endpoint,
# set the credential and its required header (for example, Authorization).
ORNN_API_KEY=
ORNN_API_KEY_HEADER=Authorization
ORNN_API_KEY_PREFIX="Bearer "
# Example: ORNN_FEEDS="H100 SXM=0x...,B200=0x..."
ORNN_FEEDS=
# The post is rejected if Ornn's source timestamp is older than this.
ORNN_MAX_SOURCE_AGE_SECONDS=5400

# Set true to inspect the proposed rate without sending transactions.
DRY_RUN=false
