# ═══════════════════════════════════════════════════════════════════════════
# Parthenon Fi — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ─── Common ───────────────────────────────────────────────────────────────
PRIVATE_KEY=
SEPOLIA_URL=https://sepolia.infura.io/v3/YOUR-PROJECT-ID
ETHERSCAN_API_KEY=

# ─── Module 1: P2P Lending (deploy-module1-sepolia.ts) ───────────────────
# Omit token addresses to auto-deploy mock ERC20s on testnet
# WBTC_ADDRESS=
# WETH_ADDRESS=
# USDC_ADDRESS=
# USDT_ADDRESS=
# FEE_RECIPIENT=          # default: deployer
# PROTOCOL_FEE_BPS=500    # default: 500 (5%)

# ─── Module 2: Undercollateralized Lending (deploy-module2-sepolia.ts) ───
ASSET_TOKEN=
BORROWER_ADDRESS=
# FEE_RECIPIENT=          # default: deployer
# RELAYER_ADDRESS=         # default: deployer
# ATTESTER_ADDRESS=        # default: deployer
# LENDER_ADDRESS=
# BORROWER_TIER=1          # 0=$100K, 1=$500K, 2=$2M, 3=$10M
# INTEREST_BIPS=500        # 5% APR
# RESERVE_BIPS=2000        # 20%
# MAX_SUPPLY=1000000

# ─── Pool + Optimizer Stack (deploy-all.ts) ──────────────────────────────
PRICE_ORACLE=
LOAN_TOKEN=
COLLATERAL_TOKEN=
LOAN_FACTORY=
# ALLOCATION_CAP=0         # 0 = unlimited
